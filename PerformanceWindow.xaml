<Window x:Class="ParallelDiskTree.PerformanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PERFORMANCE // 3099 — история сканирования"
        Width="1170" Height="810" MinWidth="780" MinHeight="590"
        WindowStartupLocation="CenterOwner"
        Background="#080B19" Foreground="#DCEAFF" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="CyanNeon" Color="#00F5E9"/>
    <SolidColorBrush x:Key="PinkNeon" Color="#FF47BD"/>
    <SolidColorBrush x:Key="Muted" Color="#8198BF"/>
    <Style x:Key="NeonButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Background" Value="#26264D"/>
      <Setter Property="Foreground" Value="#CCFBFF"/>
      <Setter Property="BorderBrush" Value="#5A58B9"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="MetricNumber" TargetType="TextBlock">
      <Setter Property="FontSize" Value="27"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="Foreground" Value="{StaticResource CyanNeon}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="MetricName" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="MetricCard" TargetType="Border">
      <Setter Property="Background" Value="#111C32"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#214C69"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="15,11"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#090D1C" Offset="0"/>
        <GradientStop Color="#16102F" Offset="0.52"/>
        <GradientStop Color="#070F24" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,20,24,24">
        <Grid Margin="0,0,0,17">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="// NEON TELEMETRY • YEAR 3099" Foreground="#F95BC9" FontFamily="Consolas" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Text="PERFORMANCE  /  3099" FontSize="31" FontWeight="Bold" Foreground="#E7F6FF" Margin="0,4,0,0">
              <TextBlock.Effect><DropShadowEffect Color="#1DE9F0" BlurRadius="14" ShadowDepth="0" Opacity="0.45"/></TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="ИСТОРИЯ РЕАЛЬНЫХ СКАНИРОВАНИЙ  •  ЛУЧШИЕ ОТДЕЛЬНЫЕ ПРОХОДЫ" Foreground="#94AEC9" FontSize="11" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Content="⟳ ОБНОВИТЬ ИЗ ЛОГОВ ПРИЛОЖЕНИЯ" Style="{StaticResource NeonButton}" Click="Refresh_Click" Margin="0,0,8,0"/>
            <Button Content="✕ ЗАКРЫТЬ" Style="{StaticResource NeonButton}" Click="Close_Click"/>
          </StackPanel>
        </Grid>
        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,15">
          <Border Style="{StaticResource MetricCard}">
            <StackPanel><TextBlock Text="⚡  ABSOLUTE RECORD" Style="{StaticResource MetricName}"/><TextBlock x:Name="RecordText" Style="{StaticResource MetricNumber}" Text="34,210 с" Margin="0,6,0,2"/><TextBlock x:Name="RecordSub" Text="🔥 Адаптивный" Foreground="#A5BDE0" FontSize="11"/><TextBlock Text="THAT’S GREAT  //  FANTASTIC" Foreground="#F95BC9" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
          </Border>
          <Border Style="{StaticResource MetricCard}">
            <StackPanel><TextBlock Text="OBJECTS INDEXED" Style="{StaticResource MetricName}"/><TextBlock x:Name="ObjectsText" Style="{StaticResource MetricNumber}" Text="1 816 632" Margin="0,6,0,2"/><TextBlock Text="Файлы + папки в рекорде" Foreground="#A5BDE0" FontSize="11"/></StackPanel>
          </Border>
          <Border Style="{StaticResource MetricCard}">
            <StackPanel><TextBlock Text="LOGICAL SIZE" Style="{StaticResource MetricName}"/><TextBlock x:Name="VolumeText" Style="{StaticResource MetricNumber}" Text="430,64 GiB" Margin="0,6,0,2"/><TextBlock Text="Байты файлов, не занятое место" Foreground="#A5BDE0" FontSize="11"/></StackPanel>
          </Border>
          <Border Style="{StaticResource MetricCard}" Margin="0">
            <StackPanel><TextBlock Text="SPEED-UP / ЭТАЛОН 320,991 С" Style="{StaticResource MetricName}"/><TextBlock x:Name="SpeedupText" Style="{StaticResource MetricNumber}" Text="4,14×" Foreground="{StaticResource PinkNeon}" Margin="0,6,0,2"/><TextBlock Text="От первого прохода 320 990,849 мс" Foreground="#A5BDE0" FontSize="11"/></StackPanel>
          </Border>
        </UniformGrid>
        <Border Background="#0D182B" BorderBrush="#344969" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
          <StackPanel>
            <Grid Margin="4,0,4,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="SCANNING LATENCY  /  N EXECUTORS" Foreground="{StaticResource CyanNeon}" FontFamily="Consolas" FontWeight="Bold" FontSize="15"/>
                <TextBlock Text="Лучшие отдельные проходы • Y не от нуля • меньше = быстрее • 🔥 отдельно от N" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="● MEASURED DATA   /   NOT A SIMULATION" Foreground="#FF5CBD" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
            <Canvas x:Name="ChartCanvas" Height="310" MinWidth="540" SizeChanged="ChartCanvas_SizeChanged" ClipToBounds="True"/>
          </StackPanel>
        </Border>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="RUN ARCHIVE // BASELINE + FIXED + ADAPTIVE" Foreground="#B7C7FF" FontFamily="Consolas" FontWeight="Bold" FontSize="12"/>
          <TextBlock Grid.Column="1" Text="Эталон: 320 990,849 мс • все ускорения от него" Foreground="#ED91C8" FontSize="11"/>
        </Grid>
        <TextBlock Text="По горизонтали можно прокручивать таблицу. Метрики CPU/очереди/каталогов/простоя относятся именно к выбранному рекордному проходу; «—» означает отсутствие измерений."
                   TextWrapping="Wrap" Foreground="#8198BF" FontSize="10" Margin="0,0,0,7"/>
        <DataGrid x:Name="RecordsGrid" AutoGenerateColumns="False" CanUserSortColumns="False" IsReadOnly="True"
                  Height="272" RowHeight="30" FrozenColumnCount="1" HeadersVisibility="Column"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True" MinColumnWidth="70">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Режим" Binding="{Binding ModeLabel}" Width="225"/>
            <DataGridTextColumn Header="N" Binding="{Binding Workers}" Width="55"/>
            <DataGridTextColumn Header="Время" Binding="{Binding SecondsLabel}" Width="138"/>
            <DataGridTextColumn Header="Ускорение" Binding="{Binding SpeedupLabel}" Width="108"/>
            <DataGridTextColumn Header="Прогонов" Binding="{Binding RunsLabel}" Width="88"/>
            <DataGridTextColumn Header="CPU %" Binding="{Binding CpuLabel}" Width="86"/>
            <DataGridTextColumn Header="Очередь ср., мс" Binding="{Binding QueueLabel}" Width="141"/>
            <DataGridTextColumn Header="Каталоги, поток·с" Binding="{Binding DirectoryLabel}" Width="157"/>
            <DataGridTextColumn Header="Простой, поток·с" Binding="{Binding IdleLabel}" Width="157"/>
            <DataGridTextColumn Header="Файлов" Binding="{Binding FilesLabel}" Width="128"/>
            <DataGridTextColumn Header="Папок" Binding="{Binding FoldersLabel}" Width="115"/>
            <DataGridTextColumn Header="Байт" Binding="{Binding BytesLabel}" Width="188"/>
            <DataGridTextColumn Header="Объектов/с" Binding="{Binding ObjectsLabel}" Width="117"/>
            <DataGridTextColumn Header="Время записи" Binding="{Binding Timestamp}" Width="160"/>
            <DataGridTextColumn Header="Источник" Binding="{Binding SourceLabel}" Width="150"/>
          </DataGrid.Columns>
        </DataGrid>
        <Border Background="#22162E" BorderBrush="#84427D" BorderThickness="1" Padding="10" CornerRadius="5" Margin="0,13,0,0">
          <TextBlock Text="⚠ База сравнения: первое последовательное сканирование 320 990,849 мс — единственная строка для N=1 и точка графика. Остальные строки — лучшие отдельные проходы, а не медианы. «Прогонов» — число уникальных успешных замеров, доступных во встроенном архиве и журналах рядом с программой. CPU — средняя загрузка процесса за конкретный проход; очередь — среднее ожидание задания; каталоги/простой — суммарные поток·секунды. Где нет исходных измерений, стоит «—». Данные могли меняться между проходами; ускорение не является строгим контролируемым экспериментом." TextWrapping="Wrap" Foreground="#CFB4D9" FontSize="11"/>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
