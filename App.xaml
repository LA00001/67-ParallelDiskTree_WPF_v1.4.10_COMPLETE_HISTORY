<Application x:Class="ParallelDiskTree.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#10151F"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1B2330"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#43C5B6"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#293B4E"/>
      <Setter Property="Foreground" Value="#F0F5FB"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="15,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#202C3B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#34475A"/><Setter Property="Padding" Value="9,7"/><Setter Property="CaretBrush" Value="White"/></Style>
    <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="#E5EAF0"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="#18212D"/><Setter Property="Foreground" Value="#E5EEF9"/><Setter Property="RowBackground" Value="#18212D"/><Setter Property="AlternatingRowBackground" Value="#202B38"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="SelectionMode" Value="Single"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#263648"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#E5EEF9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,5"/></Style>
  </Application.Resources>
</Application>
