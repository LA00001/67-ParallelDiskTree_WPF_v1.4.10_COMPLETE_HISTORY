<Window x:Class="ParallelDiskTree.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parallel Disk Tree v1.4.9 — Portable Statistics 3099"
        Width="1560" Height="900" MinWidth="850" MinHeight="580"
        Background="{StaticResource BackgroundBrush}" Foreground="#F0F5FB"
        FontFamily="Segoe UI" WindowStartupLocation="Manual">
  <Window.Resources>
    <Style x:Key="ChevronButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="25"/>
      <Setter Property="Height" Value="23"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="#254050"/>
      <Setter Property="Foreground" Value="#43C5B6"/>
      <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="ToolTip" Value="Свернуть раздел"/>
    </Style>
  </Window.Resources>
  <!-- Вертикальная прокрутка страницы. Горизонтальная запрещена: она сдвигала
       все органы управления за левую границу при BringIntoView/фокусе.
       Горизонтальные полосы остаются только у широких таблиц. -->
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                PanningMode="VerticalOnly" Focusable="False">
  <Grid Margin="16" HorizontalAlignment="Stretch" ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 1/7: title/subtitle; scan and stop buttons stay accessible below -->
    <Grid Grid.Row="0" Margin="0,0,0,11">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="TitleToggle" Grid.Column="0" Style="{StaticResource ChevronButtonStyle}"
              Content="▼" Tag="TitlePanel" Click="ToggleSection_Click" VerticalAlignment="Top" Margin="0,2,7,0"/>
      <StackPanel x:Name="TitlePanel" Grid.Column="1">
        <TextBlock Text="PARALLEL DISK TREE" Foreground="#43C5B6" FontSize="25" FontWeight="Bold"/>
        <TextBlock Text="Последовательный / параллельный / 🔥 Адаптивный 32 / 🔥🔥64 Адаптивный · реальные байты"
                   Foreground="#94AABD" FontSize="13" Margin="0,4,0,0"/>
      </StackPanel>
    </Grid>

    <!-- Путь и кнопки в двух строках. WrapPanel переносит действия при узком окне. -->
    <StackPanel Grid.Row="1" x:Name="ActionsPanel" Margin="0,0,0,10">
      <Grid Margin="0,0,0,7">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="PathBox" VerticalContentAlignment="Center" Text="C:\" Margin="0,0,8,0"/>
        <Button Grid.Column="1" x:Name="BrowseButton" Content="Обзор…" Click="Browse_Click" Margin="0"/>
      </Grid>
      <WrapPanel>
        <Button x:Name="StartButton" Content="▶ Сканировать" Background="#167E75" Click="Start_Click" Margin="0,0,8,7"/>
        <Button x:Name="CompareButton" Content="⚖ A/B тест" Background="#265A87" Click="Compare_Click" Margin="0,0,8,7"/>
        <Button x:Name="AutoButton" Content="▶ Автобенчмарк" Background="#36638B" Click="AutoBenchmark_Click" Margin="0,0,8,7"/>
        <Button x:Name="AdaptiveButton" Content="🔥 Адаптивный" Background="#925C20" Click="Adaptive_Click"
                ToolTip="Один проход с автоматической сменой количества исполнителей: 4→8→16→32 и обратно." Margin="0,0,8,7"/>
        <Button x:Name="Adaptive64Button" Content="🔥🔥64 Адаптивный" Background="#AC3165" Click="Adaptive64_Click"
                ToolTip="Отдельный экспериментальный режим: 4→8→16→32→64 и обратно за один проход." Margin="0,0,8,7"/>
        <Button x:Name="StopButton" Content="■ Стоп" Click="Stop_Click" IsEnabled="False" Margin="0,0,8,7"/>
        <Button x:Name="ExportButton" Content="Экспорт дерева CSV" Click="Export_Click" Margin="0,0,8,7"/>
        <Button x:Name="StatisticsButton" Content="⚡ Статистика 3099" Click="Statistics_Click" Background="#56269B" ToolTip="Рекорды из встроенного архива и журналов рядом с программой" Margin="0,0,8,7"/>
        <Button Content="Логи ↗" Click="OpenLogs_Click" Margin="0,0,0,7"/>
      </WrapPanel>
    </StackPanel>

    <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12,9" Margin="0,0,0,11">
      <StackPanel Orientation="Vertical" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
          <Button x:Name="OptionsToggle" Style="{StaticResource ChevronButtonStyle}"
                  Content="▼" Tag="OptionsPanel" Click="ToggleSection_Click" Margin="0,0,7,0"/>
          <TextBlock Text="РЕЖИМЫ И НАСТРОЙКИ" VerticalAlignment="Center" Foreground="#91A6BB" FontSize="11"/>
        </StackPanel>
        <StackPanel x:Name="OptionsPanel">
        <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="РЕЖИМ" Foreground="#91A6BB" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox x:Name="ModeBox" Width="242" Height="33" SelectedIndex="1" VerticalContentAlignment="Center" Margin="0,0,24,0">
          <ComboBoxItem Content="Последовательный (1)"/>
          <ComboBoxItem Content="Параллельный (N)"/>
          <ComboBoxItem Content="🔥 Адаптивный (4→32)"/>
          <ComboBoxItem Content="🔥🔥64 Адаптивный (4→64)"/>
        </ComboBox>
        <TextBlock Text="ИСПОЛНИТЕЛИ (N)" Foreground="#91A6BB" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox x:Name="WorkersBox" Text="4" Width="68" MaxLength="2" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,10,0" ToolTip="Число исполнителей параллельного режима, от 1 до 64"/>
        <TextBlock Text="от 1 до 64" Foreground="#91A6BB" VerticalAlignment="Center" Margin="0,0,30,0"/>
        <CheckBox x:Name="ParallelFirstBox" Content="A/B: сначала параллельный" Foreground="#DEE8F0" VerticalAlignment="Center" Margin="0,0,30,0"/>
        <TextBlock Text="A/B: два отдельных сканирования" Foreground="#91A6BB" VerticalAlignment="Center"/>
        </WrapPanel>
        <WrapPanel VerticalAlignment="Center" Margin="0,10,0,0">
          <TextBlock Text="АВТО: ИСПОЛНИТЕЛИ" Foreground="#91A6BB" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBox x:Name="AutoWorkersBox" Text="1,2,4,8,16,32" Width="182" MaxLength="75" VerticalContentAlignment="Center" Margin="0,0,18,0" ToolTip="1 = последовательный обход. 2,4,8... = параллельный обход, максимум 64"/>
          <TextBlock Text="ПОВТОРЫ" Foreground="#91A6BB" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBox x:Name="RepeatsBox" Text="3" Width="48" MaxLength="1" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,16,0" ToolTip="Число повторов каждого режима: от 1 до 5"/>
          <TextBlock Text="По умолчанию: 6 режимов × 3 = 18 сканирований. Порядок чередуется в каждом повторе." Foreground="#91A6BB" VerticalAlignment="Center"/>
        </WrapPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Background="{StaticResource CardBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,10">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
          <Button x:Name="StatsToggle" Style="{StaticResource ChevronButtonStyle}"
                  Content="▼" Tag="StatsPanel" Click="ToggleSection_Click" Margin="0,0,7,0"/>
          <TextBlock Text="СТАТИСТИКА СКАНИРОВАНИЯ" VerticalAlignment="Center" Foreground="#91A6BB" FontSize="11"/>
        </StackPanel>
        <StackPanel x:Name="StatsPanel">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0"><TextBlock Text="НАЙДЕНО" Foreground="#91A6BB" FontSize="11"/><TextBlock x:Name="TotalSizeText" Text="0 B" FontSize="23" FontWeight="SemiBold"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="ФАЙЛЫ" Foreground="#91A6BB" FontSize="11"/><TextBlock x:Name="FilesText" Text="0" FontSize="23" FontWeight="SemiBold"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="ПАПКИ" Foreground="#91A6BB" FontSize="11"/><TextBlock x:Name="FoldersText" Text="0" FontSize="23" FontWeight="SemiBold"/></StackPanel>
          <StackPanel Grid.Column="3"><TextBlock Text="ОЧЕРЕДЬ / АКТИВНЫЕ / ОШИБКИ" TextWrapping="Wrap" Foreground="#91A6BB" FontSize="11"/><TextBlock x:Name="QueueText" Text="0 / 0 / 0" FontSize="21" FontWeight="SemiBold"/></StackPanel>
          <StackPanel Grid.Column="4"><TextBlock Text="ПРОШЛО ВРЕМЕНИ" Foreground="#91A6BB" FontSize="11"/><TextBlock x:Name="ElapsedText" Text="0,000 с" FontSize="21" FontWeight="SemiBold"/></StackPanel>
        </Grid>
        <ProgressBar x:Name="BusyBar" Height="4" Margin="0,10,0,0" Foreground="#43C5B6" IsIndeterminate="False" Value="0"/>
        <StackPanel x:Name="AdaptiveStatsPanel" Visibility="Collapsed" Margin="0,8,0,0">
          <TextBlock x:Name="AdaptiveLiveText" Text="🔥 Адаптивный: 4 активных разрешено · собираю показатели…" Foreground="#F5BA60" FontSize="12"/>
          <TextBlock x:Name="DiskLiveText" Text="Windows PDH: активность н/д · задержка н/д · скорость диска н/д" Foreground="#91A6BB" FontSize="11" Margin="0,2,0,0"/>
        </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="4" Background="{StaticResource CardBrush}" CornerRadius="9" Padding="12" Margin="0,0,0,10">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
          <Button x:Name="BenchmarkToggle" Style="{StaticResource ChevronButtonStyle}"
                  Content="▼" Tag="BenchmarkPanel" Click="ToggleSection_Click" Margin="0,0,7,0"/>
          <TextBlock Text="БЕНЧМАРК — медианы и полные проходы" VerticalAlignment="Center" FontWeight="Bold" Foreground="#9BB0C4" FontSize="12"/>
        </StackPanel>
        <StackPanel x:Name="BenchmarkPanel">
        <TextBlock x:Name="ComparisonText" Text="A/B — два прохода; Автобенчмарк — 1/2/4/8/16/32 × 3; 🔥 32 и 🔥🔥64 — отдельные адаптивные режимы."
                   Foreground="#43C5B6" Margin="0,4,0,7" FontSize="12" TextWrapping="Wrap"/>
        <StackPanel x:Name="AdaptiveHistoryPanel" Visibility="Collapsed" Margin="0,4,0,10">
          <TextBlock Text="🔥 Адаптивный (32/64) — наблюдения, PDH Windows (весь логический том)" Foreground="#F5BA60" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <DataGrid x:Name="AdaptiveHistoryGrid" Height="130" AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" CanUserSortColumns="False" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Прошло" Binding="{Binding TimeText}" Width="72"/>
              <DataGridTextColumn Header="N" Binding="{Binding WorkersText}" Width="38"/>
              <DataGridTextColumn Header="Активных" Binding="{Binding Active}" Width="75"/>
              <DataGridTextColumn Header="Очередь" Binding="{Binding Backlog}" Width="80"/>
              <DataGridTextColumn Header="Объектов/с" Binding="{Binding ObjectsText}" Width="104"/>
              <DataGridTextColumn Header="Disk Time" Binding="{Binding BusyText}" Width="88"/>
              <DataGridTextColumn Header="мс / запрос" Binding="{Binding LatencyText}" Width="100"/>
              <DataGridTextColumn Header="MiB/с" Binding="{Binding ThroughputText}" Width="75"/>
              <DataGridTextColumn Header="Решение" Binding="{Binding Decision}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <Button x:Name="MedianToggle" Style="{StaticResource ChevronButtonStyle}"
                  Content="▶" Tag="MedianGrid" Click="ToggleSection_Click" ToolTip="Развернуть раздел" Margin="0,0,7,0"/>
          <TextBlock Text="СВОДКА: полные проходы без ошибок, медиана, диапазон, ускорение к последовательному 1"
                     VerticalAlignment="Center" Foreground="#91A6BB" FontSize="11"/>
        </StackPanel>
        <DataGrid x:Name="MedianGrid" Visibility="Collapsed" Height="138" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="False"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Режим" Binding="{Binding Mode}" Width="140"/>
            <DataGridTextColumn Header="N" Binding="{Binding Workers}" Width="45"/>
            <DataGridTextColumn Header="Прогонов" Binding="{Binding RunsText}" Width="73"/>
            <DataGridTextColumn Header="Медиана" Binding="{Binding MedianText}" Width="100"/>
            <DataGridTextColumn Header="Лучшее" Binding="{Binding BestText}" Width="100"/>
            <DataGridTextColumn Header="Худшее" Binding="{Binding WorstText}" Width="100"/>
            <DataGridTextColumn Header="Ускорение" Binding="{Binding SpeedupText}" Width="90"/>
            <DataGridTextColumn Header="Данные" Binding="{Binding MatchText}" Width="65"/>
            <DataGridTextColumn Header="CPU %" Binding="{Binding CpuText}" Width="75"/>
            <DataGridTextColumn Header="Очередь ср. мс" Binding="{Binding WaitText}" Width="115"/>
            <DataGridTextColumn Header="Каталоги, поток·с" Binding="{Binding DirectoryText}" Width="145"/>
            <DataGridTextColumn Header="Простой, поток·с" Binding="{Binding IdleText}" Width="135"/>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" Margin="0,7,0,4">
          <Button x:Name="RunsToggle" Style="{StaticResource ChevronButtonStyle}"
                  Content="▶" Tag="BenchmarkGrid" Click="ToggleSection_Click" ToolTip="Развернуть раздел" Margin="0,0,7,0"/>
          <TextBlock Text="ВСЕ ПРОХОДЫ: локальное время, скорость, объекты и диагностика"
                     VerticalAlignment="Center" Foreground="#91A6BB" FontSize="11"/>
        </StackPanel>
        <DataGrid x:Name="BenchmarkGrid" Visibility="Collapsed" Height="116" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserSortColumns="False"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SelectionMode="Single">
          <DataGrid.Columns>
            <DataGridTextColumn Header="№" Binding="{Binding Order}" Width="40"/>
            <DataGridTextColumn Header="Повтор" Binding="{Binding Repeat}" Width="62"/>
            <DataGridTextColumn Header="Режим" Binding="{Binding Mode}" Width="146"/>
            <DataGridTextColumn Header="N" Binding="{Binding Workers}" Width="45"/>
            <DataGridTextColumn Header="Начало" Binding="{Binding StartedText}" Width="215"/>
            <DataGridTextColumn Header="Конец" Binding="{Binding FinishedText}" Width="215"/>
            <DataGridTextColumn Header="Время" Binding="{Binding ElapsedText}" Width="92"/>
            <DataGridTextColumn Header="Объектов/сек" Binding="{Binding SpeedText}" Width="110"/>
            <DataGridTextColumn Header="Файлов" Binding="{Binding FilesText}" Width="105"/>
            <DataGridTextColumn Header="Папок" Binding="{Binding FoldersText}" Width="97"/>
            <DataGridTextColumn Header="Байт" Binding="{Binding BytesText}" Width="138"/>
            <DataGridTextColumn Header="Ошибок" Binding="{Binding Errors}" Width="66"/>
            <DataGridTextColumn Header="CPU %" Binding="{Binding CpuText}" Width="80"/>
            <DataGridTextColumn Header="Каталоги, поток·с" Binding="{Binding WorkText}" Width="137"/>
            <DataGridTextColumn Header="Очередь ср. мс" Binding="{Binding QueueWaitText}" Width="120"/>
            <DataGridTextColumn Header="Простой, поток·с" Binding="{Binding IdleText}" Width="127"/>
            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="96"/>
          </DataGrid.Columns>
        </DataGrid>
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="5" x:Name="ResultsPanel" Height="520" MinHeight="400">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="TreeColumn" Width="340" MinWidth="64"/>
        <ColumnDefinition x:Name="TreeDividerColumn" Width="6"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource CardBrush}" CornerRadius="9" Padding="10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="TreeToggle" Style="{StaticResource ChevronButtonStyle}"
                    Content="▼" Tag="FolderTree" Click="ToggleSection_Click" Margin="0,0,7,0"/>
            <TextBlock x:Name="FolderTreeTitle" Text="ДЕРЕВО ПАПОК" FontSize="12" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="#9BB0C4"/>
          </StackPanel>
          <TreeView x:Name="FolderTree" Background="Transparent" BorderThickness="0" SelectedItemChanged="FolderTree_SelectedItemChanged"
                    VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"/>
        </DockPanel>
      </Border>
      <GridSplitter x:Name="TreeDivider" Grid.Column="1" Width="6" Background="Transparent" HorizontalAlignment="Stretch"/>
      <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="9" Padding="12">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="CurrentPath" Text="Выберите папку слева" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              <TextBlock x:Name="CurrentBytes" Text="" Foreground="#94AABD" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Открыть в Проводнике ↗" Click="Open_Click"/>
          </Grid>
          <!-- "Назад / Далее" navigate the VISITED FOLDERS (browser-style history).
               Pagination gets separate controls to avoid disabled history buttons on a
               directory with fewer than 500 entries. Both groups stay above the grid. -->
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" VerticalAlignment="Center">
            <TextBlock Text="ИСТОРИЯ ПАПОК" VerticalAlignment="Center" Foreground="#8EACBC"
                       FontSize="11" Margin="0,0,10,4"/>
            <Button x:Name="PreviousButton" Content="◀ Назад" Click="Previous_Click"
                    Margin="0,0,8,4" IsEnabled="False"/>
            <Button x:Name="NextButton" Content="Далее ▶" Click="Next_Click"
                    Margin="0,0,16,4" IsEnabled="False"/>
            <TextBlock Text="СТРАНИЦЫ" VerticalAlignment="Center" Foreground="#8EACBC"
                       FontSize="11" Margin="0,0,10,4"/>
            <Button x:Name="PreviousPageButton" Content="◀ Страница" Click="PreviousPage_Click"
                    Margin="0,0,8,4" IsEnabled="False" ToolTip="Предыдущие 500 элементов текущей папки"/>
            <Button x:Name="NextPageButton" Content="Страница ▶" Click="NextPage_Click"
                    Margin="0,0,8,4" IsEnabled="False" ToolTip="Следующие 500 элементов текущей папки"/>
            <TextBlock x:Name="PageText" VerticalAlignment="Center" Foreground="#9BB0C4"
                       Margin="10,0,0,4"/>
          </WrapPanel>
          <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2"
                    SelectionUnit="FullRow" MouseDoubleClick="ItemsGrid_MouseDoubleClick" ScrollViewer.CanContentScroll="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="70"/>
              <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Размер" Binding="{Binding Pretty}" Width="118"/>
              <DataGridTextColumn Header="Байт" Binding="{Binding Bytes}" Width="128"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="6" x:Name="StatusText" Text="Готово. Сканер только читает данные, ничего не удаляет и не переносит."
               Foreground="#91A6BB" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
  </Grid>
  </ScrollViewer>
</Window>
